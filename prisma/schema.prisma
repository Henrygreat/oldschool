// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANT CORE MODELS
// ============================================

model School {
  id             String   @id @default(cuid())
  name           String
  shortName      String   @unique
  description    String?
  domain         String?  @unique
  logoUrl        String?
  bannerUrl      String?
  primaryColor   String?
  secondaryColor String?
  terminology    Json? // Store tenant-specific terminology
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  domains              SchoolDomain[]
  administrators       SchoolAdministrator[]
  users                User[]
  alumniProfiles       AlumniProfile[]
  alumniArchiveRecords AlumniArchiveRecord[]
  alumniImportBatches  AlumniImportBatch[]
  alumniClaims         AlumniProfileClaim[]
  academicYears        AcademicYear[]
  cohorts              Cohort[]
  houses               House[]
  classGroups          ClassGroup[]
  chapters             Chapter[]
  announcements        Announcement[]
  events               Event[]
  chapterJoinRequests  ChapterJoinRequest[]
  posts                Post[]
  verifications        VerificationRequest[]
  invitations          Invitation[]
  auditLogs            AuditLog[]

  @@index([shortName])
  @@index([isActive])
}

model SchoolDomain {
  id        String   @id @default(cuid())
  schoolId  String
  domain    String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([domain])
}

model SchoolAdministrator {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  role      AdminRole @default(SCHOOL_ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
}

enum AdminRole {
  SUPER_ADMIN
  NATIONAL_ADMIN
  SCHOOL_ADMIN
  CHAPTER_ADMIN
  SET_ADMIN
  MODERATOR
  MEMBER
}

// ============================================
// USER AND AUTHENTICATION
// ============================================

model User {
  id              String    @id @default(cuid())
  schoolId        String
  email           String    @unique
  emailVerified   DateTime?
  password        String
  firstName       String
  middleName      String?
  surname         String
  formerSurname   String?
  nickname        String?
  profilePhotoUrl String?
  profilePhotoKey String?
  coverPhotoUrl   String?
  role            AdminRole @default(MEMBER)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school                   School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  alumniProfile            AlumniProfile?
  schoolAdministrator      SchoolAdministrator[]
  uploadedAlumniImports    AlumniImportBatch[]       @relation("AlumniImportUploader")
  claimedArchiveRecord     AlumniArchiveRecord?      @relation("ArchiveRecordClaimedBy")
  alumniProfileClaims      AlumniProfileClaim[]      @relation("AlumniClaimant")
  reviewedAlumniClaims     AlumniProfileClaim[]      @relation("AlumniClaimReviewer")
  connectionsFrom          Connection[]              @relation("ConnectionFrom")
  connectionsTo            Connection[]              @relation("ConnectionTo")
  follows                  Follow[]                  @relation("UserFollows")
  followedBy               Follow[]                  @relation("UserFollowedBy")
  posts                    Post[]
  reactions                Reaction[]
  comments                 Comment[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  sentInvitations          Invitation[]
  notifications            Notification[]            @relation("NotificationRecipient")
  triggeredNotifications   Notification[]            @relation("NotificationActor")
  reports                  Report[]
  privacySettings          PrivacySetting[]
  administeredCohorts      CohortAdministrator[]
  administeredChapters     ChapterAdministrator[]
  authoredAnnouncements    Announcement[]          @relation("AnnouncementAuthor")
  organizedEvents          Event[]                  @relation("EventOrganizer")
  eventRSVPs               EventRSVP[]
  chapterJoinRequests      ChapterJoinRequest[]     @relation("ChapterJoinRequester")
  reviewedChapterRequests  ChapterJoinRequest[]     @relation("ChapterJoinReviewer")
  reportsAgainst           Report[]                 @relation("ReportedUser")
  reviewedReports          Report[]                 @relation("ReportReviewer")

  @@index([schoolId])
  @@index([email])
  @@index([schoolId, isActive])
  @@index([schoolId, isActive, surname, firstName])
}

model AlumniProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  schoolId              String
  biography             String?
  currentCity           String?
  currentCountry        String?
  profession            String?
  jobTitle              String?
  company               String?
  industry              String?
  phone                 String?
  linkedInUrl           String?
  websiteUrl            String?
  professionalInterests String?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?
  verifiedBy            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolAttendance     SchoolAttendance[]
  employments          Employment[]
  educations           Education[]
  skills               Skill[]
  chapterMemberships   ChapterMember[]
  verificationRequests VerificationRequest[]

  @@index([schoolId])
  @@index([userId])
  @@index([verificationStatus])
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// ============================================
// SCHOOL ATTENDANCE & STRUCTURE
// ============================================

model SchoolAttendance {
  id              String   @id @default(cuid())
  alumniProfileId String
  schoolId        String
  entryYear       Int?
  leavingYear     Int?
  studentNumber   String?
  cohortId        String?
  houseId         String?
  classGroupId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  cohort        Cohort?       @relation(fields: [cohortId], references: [id])
  house         House?        @relation(fields: [houseId], references: [id])
  classGroup    ClassGroup?   @relation(fields: [classGroupId], references: [id])

  @@index([alumniProfileId])
  @@index([schoolId])
  @@index([cohortId])
  @@index([houseId])
  @@index([entryYear, leavingYear])
}

model AcademicYear {
  id        String    @id @default(cuid())
  schoolId  String
  year      Int
  name      String
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, year])
  @@index([schoolId])
}

model Cohort {
  id          String   @id @default(cuid())
  schoolId    String
  year        Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolAttendances    SchoolAttendance[]
  alumniArchiveRecords AlumniArchiveRecord[]
  posts                Post[]
  administrators       CohortAdministrator[]
  announcements        Announcement[]
  events               Event[]

  @@unique([schoolId, year])
  @@index([schoolId])
}

model CohortAdministrator {
  id        String   @id @default(cuid())
  cohortId  String
  userId    String
  createdAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId])
}

model House {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  color       String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolAttendances SchoolAttendance[]
  posts             Post[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassGroup {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  year        Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolAttendances SchoolAttendance[]

  @@index([schoolId])
}

// ============================================
// CHAPTERS
// ============================================

model Chapter {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  country     String?
  region      String?
  city        String?
  description String?
  contactInfo String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  members ChapterMember[]
  administrators ChapterAdministrator[]
  joinRequests ChapterJoinRequest[]
  announcements Announcement[]
  events Event[]
  posts   Post[]

  @@index([schoolId])
  @@index([country])
  @@index([city])
}

model ChapterMember {
  id              String   @id @default(cuid())
  chapterId       String
  alumniProfileId String
  role            String?
  joinedAt        DateTime @default(now())

  chapter       Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@unique([chapterId, alumniProfileId])
  @@index([chapterId])
  @@index([alumniProfileId])
}

model ChapterAdministrator {
  id        String   @id @default(cuid())
  chapterId String
  userId    String
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chapterId, userId])
  @@index([userId])
}

model ChapterJoinRequest {
  id         String                 @id @default(cuid())
  schoolId   String
  chapterId  String
  userId     String
  status     ChapterJoinRequestStatus @default(PENDING)
  message    String?
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chapter  Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user     User    @relation("ChapterJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ChapterJoinReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([chapterId, userId])
  @@index([schoolId, status, createdAt])
  @@index([chapterId, status])
}

enum ChapterJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Announcement {
  id          String              @id @default(cuid())
  schoolId    String
  authorId    String
  chapterId   String?
  cohortId    String?
  isNational  Boolean             @default(false)
  title       String
  content     String
  status      CommunityContentStatus @default(DRAFT)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author  User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  cohort  Cohort?  @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, publishedAt])
  @@index([chapterId, status, publishedAt])
  @@index([cohortId, status, publishedAt])
  @@index([isNational, status, publishedAt])
}

model Event {
  id           String       @id @default(cuid())
  schoolId     String
  organizerId  String
  chapterId    String?
  cohortId     String?
  isNational   Boolean      @default(false)
  title        String
  description  String?
  eventType    EventType    @default(OTHER)
  startAt      DateTime
  endAt        DateTime?
  location     String?
  meetingUrl   String?
  capacity     Int?
  rsvpDeadline DateTime?
  status       EventStatus  @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  organizer User         @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  chapter   Chapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  cohort    Cohort?      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  rsvps     EventRSVP[]

  @@index([schoolId, status, startAt])
  @@index([chapterId, status, startAt])
  @@index([cohortId, status, startAt])
  @@index([isNational, status, startAt])
}

model EventRSVP {
  id        String      @id @default(cuid())
  eventId   String
  userId    String
  response  RSVPResponse
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, response])
  @@index([userId])
}

enum CommunityContentStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventType {
  ANNUAL_GENERAL_MEETING
  FOUNDERS_DAY
  REUNION
  CHAPTER_MEETING
  NETWORKING
  DINNER
  HOMECOMING
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RSVPResponse {
  GOING
  MAYBE
  NOT_GOING
}

// ============================================
// PROFESSIONAL INFORMATION
// ============================================

model Employment {
  id              String    @id @default(cuid())
  alumniProfileId String
  company         String
  jobTitle        String
  industry        String?
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean   @default(false)
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@index([alumniProfileId])
}

model Education {
  id              String   @id @default(cuid())
  alumniProfileId String
  institution     String
  degree          String?
  fieldOfStudy    String?
  startYear       Int?
  endYear         Int?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@index([alumniProfileId])
}

model Skill {
  id              String   @id @default(cuid())
  alumniProfileId String
  name            String
  createdAt       DateTime @default(now())

  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@unique([alumniProfileId, name])
  @@index([alumniProfileId])
}

// ============================================
// CONNECTIONS AND SOCIAL
// ============================================

model Connection {
  id         String           @id @default(cuid())
  fromUserId String
  toUserId   String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  fromUser User @relation("ConnectionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model AlumniImportBatch {
  id             String   @id @default(cuid())
  schoolId       String
  uploadedById   String
  sourceFilename String
  contentHash    String
  totalRows      Int
  importedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  duplicateCount Int      @default(0)
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())

  school     School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBy User                  @relation("AlumniImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  records    AlumniArchiveRecord[]

  @@unique([schoolId, contentHash])
  @@index([schoolId, createdAt])
  @@index([uploadedById])
}

model AlumniArchiveRecord {
  id              String              @id @default(cuid())
  schoolId        String
  importBatchId   String?
  sourceRowNumber Int?
  fullName        String
  firstName       String?
  middleName      String?
  surname         String?
  title           String?
  setYear         Int
  cohortId        String?
  house           String?
  profession      String?
  status          ArchiveRecordStatus @default(LIVING)
  email           String?
  phone           String?
  remarks         String?
  biography       String?
  photoUrl        String?
  claimedByUserId String?             @unique
  claimedAt       DateTime?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  importBatch   AlumniImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  cohort        Cohort?              @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  claimedByUser User?                @relation("ArchiveRecordClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claims        AlumniProfileClaim[]

  @@unique([importBatchId, sourceRowNumber])
  @@index([schoolId, setYear, archivedAt])
  @@index([schoolId, fullName])
  @@index([schoolId, status])
  @@index([cohortId])
}

model AlumniProfileClaim {
  id              String            @id @default(cuid())
  archiveRecordId String
  claimantUserId  String
  schoolId        String
  status          AlumniClaimStatus @default(PENDING)
  claimantMessage String?
  reviewerUserId  String?
  reviewerMessage String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  archiveRecord AlumniArchiveRecord @relation(fields: [archiveRecordId], references: [id], onDelete: Cascade)
  claimant      User                @relation("AlumniClaimant", fields: [claimantUserId], references: [id], onDelete: Cascade)
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reviewer      User?               @relation("AlumniClaimReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([archiveRecordId, status])
  @@index([claimantUserId, status])
}

enum ArchiveRecordStatus {
  LIVING
  DECEASED
  UNKNOWN
}

enum AlumniClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// POSTS AND FEED
// ============================================

model Post {
  id         String   @id @default(cuid())
  schoolId   String
  authorId   String
  content    String
  cohortId   String?
  houseId    String?
  chapterId  String?
  isOfficial Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cohort    Cohort?     @relation(fields: [cohortId], references: [id])
  house     House?      @relation(fields: [houseId], references: [id])
  chapter   Chapter?    @relation(fields: [chapterId], references: [id])
  media     PostMedia[]
  reactions Reaction[]
  comments  Comment[]
  reports   Report[]

  @@index([schoolId])
  @@index([authorId])
  @@index([cohortId])
  @@index([houseId])
  @@index([chapterId])
  @@index([createdAt])
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  url       String
  type      String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

// ============================================
// MESSAGING
// ============================================

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports      Report[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

// ============================================
// VERIFICATION
// ============================================

model VerificationRequest {
  id              String             @id @default(cuid())
  schoolId        String
  alumniProfileId String
  status          VerificationStatus @default(PENDING)
  evidence        String?
  internalNotes   String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([alumniProfileId])
  @@index([status])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  content   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================
// INVITATIONS
// ============================================

model Invitation {
  id         String    @id @default(cuid())
  schoolId   String
  senderId   String
  email      String?
  inviteCode String    @unique
  used       Boolean   @default(false)
  usedAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([senderId])
  @@index([inviteCode])
}

// ============================================
// REPORTS AND MODERATION
// ============================================

model Report {
  id             String    @id @default(cuid())
  postId         String?
  reporterId     String
  reportedUserId String?
  messageId      String?
  reason         String
  explanation    String?
  status         String    @default("PENDING")
  reviewerId     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  post         Post?    @relation(fields: [postId], references: [id])
  reporter     User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reviewer     User?    @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([reporterId])
  @@index([status])
  @@index([reportedUserId, status])
  @@index([messageId])
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================
// PRIVACY SETTINGS
// ============================================

model PrivacySetting {
  id         String          @id @default(cuid())
  userId     String
  field      String
  visibility VisibilityLevel @default(MEMBERS_ONLY)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, field])
  @@index([userId])
}

enum VisibilityLevel {
  PUBLIC
  MEMBERS_ONLY
  OLD_BOYS_ONLY
  CONNECTIONS_ONLY
  PRIVATE
}
